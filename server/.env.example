# Conexión a PostgreSQL (Neon). Copiar este archivo como .env y poner los datos reales.
# verify-full: cifra la conexión Y verifica el certificado del servidor.
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST/neondb?sslmode=verify-full&channel_binding=require"

# Puerto de la API
PORT=3000

# Oculta el aviso de "nueva versión de Prisma disponible" (NO actualizar a Prisma 8)
PRISMA_HIDE_UPDATE_MESSAGE=true

# true = imprime en consola el SQL que genera Prisma (para aprender/depurar)
LOG_SQL=true

# Solo en producción: URL(s) del frontend que pueden llamar a la API, separadas por coma.
# Vacío o sin definir = se acepta cualquier origen (desarrollo).
# CORS_ORIGIN=https://stockflow.vercel.app
